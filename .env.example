# Example environment configuration.
# Copy to `.env` and fill in your own values. Never commit real secrets.
#   cp .env.example .env
#
# The agent runs without any of these set (it falls back to keyword retrieval
# and skips the optional LLM/embedding components). Set them to enable the
# semantic-retrieval and LLM-parsing paths.

# --- Model / embedding endpoint (OpenAI-compatible) ---------------------------
# Base URL of an OpenAI-compatible API (e.g. a local Docker Model Runner or
# any hosted OpenAI-compatible endpoint).
DOCKER_MODEL_BASE_URL=http://localhost:12434/engines/v1
# API key for the endpoint above. Use "none" for a local unauthenticated model.
DOCKER_MODEL_API_KEY=none

# Embedding model name used to build/query the product embedding cache.
DOCKER_EMBED_MODEL_NAME=ai/embeddinggemma
# Prefix prepended to query text before embedding (model-specific).
DOCKER_EMBED_QUERY_PREFIX=task: search result | query:
# Prefix prepended to document text before embedding (model-specific).
DOCKER_EMBED_DOCUMENT_PREFIX=
# Max characters of input text sent per embedding request.
DOCKER_EMBED_MAX_INPUT_CHARS=

# --- Agent behavior flags (all optional; defaults shown) ----------------------
# Retrieval pipeline: "bucket" (default) | "legacy" | "hybrid".
RETRIEVAL_MODE=bucket
# Clarifying-question policy: "always_ask" (default) | "attribute_cycle".
ASK_POLICY=always_ask
# Verbose per-turn debug logging to stdout: "1" to enable.
AGENT_DEBUG=
# Constraint supersession policy: "evict_on_conflict" (default).
OVERRIDE_POLICY=evict_on_conflict
# Path to the frozen catalog file.
CATALOG_PATH=data/catalog.jsonl
# Turn-based exposure gate: "1" enabled (default), "0" to disable.
EXPOSURE_GATE=1
# Force full-list release from this turn onward (blank = use default gate).
RELEASE_TURN=
# IDF-weighted constraint matching: "1" to enable the (non-shipped) variant.
IDF_WEIGHT=
